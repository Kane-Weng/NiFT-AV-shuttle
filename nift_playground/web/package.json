{
  "name": "nift-playground-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run bundle && vite",
    "bundle": "python3 ../tools/build_bundle.py",
    "build": "npm run bundle && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e_pyodide.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "puppeteer": "23.11.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
