################################################################################
# Template for the Octane connection settings used by beacon_node.
#
# Copy this file to ".env" in the same folder and fill in the values there.
# Never put real values in this template. ".env" is ignored by git.
################################################################################

# API key for the Mcity Octane server
MCITY_OCTANE_KEY=
# Octane server URL and socket.io namespace
MCITY_OCTANE_SERVER=
MCITY_OCTANE_NAMESPACE=/octane
# IDs of the shuttle's front and rear GNSS beacons
MCITY_FRONT_BEACON_ID=
MCITY_REAR_BEACON_ID=
