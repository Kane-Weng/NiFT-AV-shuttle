# Runtime base for the source-built CARLA server: the official carlasim/carla image's recipe (Util/Docker/Release.Dockerfile:
# SDL2, Vulkan loader, libomp5, user "carla") on Ubuntu 20.04, plus the GL/EGL dispatch libs the NVIDIA Vulkan ICD needs
# under the NVIDIA container runtime. The package itself is added by build_source.sh (container copy + commit).
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive NVIDIA_DRIVER_CAPABILITIES=all
RUN apt-get update && apt-get install -y --no-install-recommends \
      libsdl2-2.0-0 libvulkan1 libomp5 libgl1 libglvnd0 libglx0 libegl1 libgles2 libxext6 libx11-6 libxrandr2 libxcursor1 \
      libxi6 libxinerama1 libxss1 libxkbcommon0 libxrender1 libxcomposite1 libxdamage1 libxfixes3 libasound2 libpulse0 \
      libfontconfig1 libfreetype6 libdbus-1-3 libnss3 xdg-user-dirs ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -u 1000 carla && mkdir -p /run/user/1000 && chown carla /run/user/1000
ENV XDG_RUNTIME_DIR=/run/user/1000
USER carla
WORKDIR /home/carla
CMD ["bash", "CarlaUE4.sh", "-RenderOffScreen", "-nosound", "-carla-rpc-port=2000"]
