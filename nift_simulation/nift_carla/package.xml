<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nift_carla</name>
  <version>0.0.0</version>
  <description>Simulation backends for the NiFT shuttle: a bridge to a CARLA 0.9.15 server running a digital twin of the test track, and a kinematic backend without CARLA. Both run the real stack through a virtual drive-by-wire ECU and an Octane GNSS emulator.</description>
  <maintainer email="kaichi@umich.edu">Kane Weng</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>can_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>lanelet2</depend>

  <depend>python3-numpy</depend>
  <exec_depend>python3-pyproj</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>diagnostic_updater</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- octane_emulator: aiohttp >= 3.9 from pip (requirements.txt; Ubuntu 22.04's python3-aiohttp is 3.8),
       python-socketio from nift_sensor -->
  <!-- tools: camera_view (Tk + PIL), eval_route (reads bags); sim_route_run (ros2 launch +
       ros2 bag record), sim_route_metrics, sim_route_plot (matplotlib, the maps of nift_waypoint) -->
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>nift_common</exec_depend>
  <exec_depend>nift_waypoint</exec_depend>
  <exec_depend>nift_bringup</exec_depend>
  <exec_depend>nift_sensor</exec_depend>
  <exec_depend>nift_control</exec_depend>
  <exec_depend>shuttle_description</exec_depend>
  <exec_depend>nift_rviz_plugins</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- The CARLA Python client (pip: carla==0.9.15) has no rosdep key; see requirements-carla.txt.
       Only carla_bridge_node, carla_scenario_node and the CARLA tools import it; the tests do not. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
