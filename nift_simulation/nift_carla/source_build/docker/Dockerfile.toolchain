# nift/carla-build:20.04 — toolchain for building Unreal 4.26 (CarlaUnreal fork) + CARLA 0.9.15 from source,
# per CARLA's Linux build guide (Ubuntu 20.04 / clang-10), with the libraries UE4Editor needs to run with
# Vulkan + X11 through the NVIDIA container runtime (verified 2026-10-12: without libgl1/libglvnd0/libglx0/
# libegl1 the Vulkan loader cannot load the injected NVIDIA ICD and falls back to llvmpipe).
# The build user has the host uid/gid so the bind-mounted tree stays owned by the host user.
FROM ubuntu:20.04
ARG UID=1000
ARG GID=1000
ARG USERNAME=builder
ARG TZ=Etc/UTC
ENV DEBIAN_FRONTEND=noninteractive TZ=${TZ} LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
      # CARLA build guide
      build-essential clang-10 lld-10 g++-7 gcc-7 cmake ninja-build libvulkan1 vulkan-tools \
      python3 python3-dev python3-pip python3-setuptools python-is-python3 libpng-dev libtiff5-dev libjpeg-dev tzdata sed curl \
      unzip autoconf automake libtool m4 rsync libxml2-dev git git-lfs wget ca-certificates gnupg software-properties-common \
      sudo xz-utils bzip2 zip file patchelf pkg-config less nano \
      # Unreal 4.26 Setup.sh dependencies (Ubuntu list) + bundled-mono runtime deps
      mono-devel mono-xbuild libmono-system-data-datasetextensions4.0-cil libmono-system-web-extensions4.0-cil \
      libmono-system-management4.0-cil libmono-system-xml-linq4.0-cil libmono-corlib4.5-cil \
      libmono-windowsbase4.0-cil libmono-system-io-compression4.0-cil \
      libmono-system-io-compression-filesystem4.0-cil libmono-system-runtime4.0-cil \
      # UE4Editor runtime: GL/Vulkan dispatch, X11, SDL, audio, fonts, GTK (file dialogs)
      libgl1 libglvnd0 libglx0 libegl1 libgles2 libxext6 libx11-6 libx11-xcb1 libxcb1 libxrandr2 libxcursor1 libxi6 \
      libxinerama1 libxss1 libxcomposite1 libxdamage1 libxfixes3 libxkbcommon0 libxkbcommon-x11-0 libxrender1 \
      libxtst6 libsdl2-2.0-0 libasound2 libpulse0 libfontconfig1 libfreetype6 libdbus-1-3 libnss3 libatk1.0-0 \
      libgtk-3-0 libxcb-xinerama0 xdg-user-dirs x11-utils x11-xserver-utils \
  && rm -rf /var/lib/apt/lists/*

# clang-10 as the default clang (CARLA guide)
RUN update-alternatives --install /usr/bin/clang++ clang++ /usr/lib/llvm-10/bin/clang++ 180 \
 && update-alternatives --install /usr/bin/clang clang /usr/lib/llvm-10/bin/clang 180 \
 && update-alternatives --install /usr/bin/ld.lld ld.lld /usr/lib/llvm-10/bin/ld.lld 180 \
 && update-alternatives --install /usr/bin/lld lld /usr/lib/llvm-10/bin/lld 180

# PythonAPI build helpers (CARLA guide)
RUN python3 -m pip install --no-cache-dir --upgrade pip \
 && python3 -m pip install --no-cache-dir setuptools distro wheel auditwheel==4.0.0

# Build user = host user; passwordless sudo because Unreal's Setup.sh apt-installs anything it misses
RUN groupadd -g ${GID} ${USERNAME} 2>/dev/null || true \
 && useradd -m -u ${UID} -g ${GID} -s /bin/bash ${USERNAME} \
 && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} && chmod 0440 /etc/sudoers.d/${USERNAME} \
 && mkdir -p /run/user/${UID} && chown ${UID}:${GID} /run/user/${UID}
ENV XDG_RUNTIME_DIR=/run/user/${UID}
ENV NVIDIA_DRIVER_CAPABILITIES=all
USER ${USERNAME}
WORKDIR /home/${USERNAME}
CMD ["/bin/bash"]
