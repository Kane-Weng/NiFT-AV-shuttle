<?xml version="1.0"?>
<!-- Materials of the box model. Only what vehicle.xacro, gps.xacro and lidar.xacro use. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="materials">

    <!-- body and roof -->
    <material name="white"><color rgba="1.0 1.0 1.0 1.0"/></material>
    <!-- front bumper, so the heading shows in RViz -->
    <material name="orange"><color rgba="1.0 0.3 0.1 1.0"/></material>
    <!-- cabin windows -->
    <material name="smoked_glass"><color rgba="0.10 0.10 0.11 0.6"/></material>
    <!-- wheels -->
    <material name="dark_grey"><color rgba="0.1 0.1 0.1 1.0"/></material>
    <!-- sensors -->
    <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>

</robot>
