<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>shuttle_description</name>
  <version>0.0.0</version>
  <description>URDF model of the NiFT shuttle (box geometry sized from nift_common/vehicle.yaml) with its launch file and RViz configs.</description>
  <maintainer email="kaichi@umich.edu">Kane Weng</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>nift_common</exec_depend>   <!-- vehicle.yaml, loaded by the xacro files -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>nift_rviz_plugins</exec_depend>   <!-- panels loaded by rviz/navigation*.rviz -->
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>liburdfdom-tools</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
