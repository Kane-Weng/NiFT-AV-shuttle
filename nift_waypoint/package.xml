<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nift_waypoint</name>
  <version>0.0.0</version>
  <description>Lanelet2 route planner for the NiFT shuttle. It turns a goal pose into a smooth path for the controller.</description>
  <maintainer email="kaichi@umich.edu">Kane Weng</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>diagnostic_msgs</depend>
  <depend>lanelet2</depend>
  <!-- ShuttleConfig and the map origin default -->
  <exec_depend>nift_common</exec_depend>
  <exec_depend>diagnostic_updater</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_waypoint_planning.py: Lanelet2's example map -->
  <test_depend>ament_index_python</test_depend>
  <test_depend>lanelet2_maps</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
